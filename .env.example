# Generate these independently using openssl rand -hex 32.
PAYMENT_API_KEY=
POSTGRES_PASSWORD=

PAYMENT_MODE=simulation
HOST=127.0.0.1
PORT=3000
PAYMENT_REQUESTS_PER_SECOND=30
PAYMENT_MAX_INFLIGHT=32

