{
  "name": "payment-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --project tsconfig.build.json && node scripts/build-dashboard.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}